{
  "uid": "system-overview",
  "title": "My dashboard",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Traffic",
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count[1m])) by (job)"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{status!~\"2..\"}[1m])) / sum(rate(http_server_requests_seconds_count[1m]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latency",
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "rate(http_server_requests_seconds_sum[5m]) / rate(http_server_requests_seconds_count[5m])"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "JVM metrics",
      "datasource": "Prometheus",
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_memory_used_bytes{job=\"auth-service\", area=\"heap\"}"
        }
      ]
    }
  ]
}